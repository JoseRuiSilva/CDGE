flowchart TD
    %% ===================================================
    %% PIPELINE ETL MEDALLION — Auto Escala
    %% Bronze → Silver → PostgreSQL → Prophet
    %% ===================================================

    classDef source   fill:#475569,stroke:#94a3b8,color:#f1f5f9
    classDef bronze   fill:#92400e,stroke:#d97706,color:#fef3c7
    classDef silver   fill:#374151,stroke:#9ca3af,color:#f9fafb
    classDef quart    fill:#7f1d1d,stroke:#ef4444,color:#fee2e2
    classDef gold     fill:#713f12,stroke:#f59e0b,color:#fef9c3
    classDef prophet  fill:#1e3a5f,stroke:#3b82f6,color:#dbeafe
    classDef control  fill:#1e1b4b,stroke:#6366f1,color:#e0e7ff

    %% ─── FONTES ─────────────────────────────────────────
    subgraph FONTES ["📂 Landing Zone  (data/sources/)"]
        direction TB
        CSV["🗂 CSV Inventário <br/> stands/YYYY_MM_stand.csv"]:::source
        JSON["📊 JSON Trends <br/> trends/YYYY/MM/trends_YYYYMM.json"]:::source
        TXT["📝 TXT Fórum <br/> forum/YYYY/MM/forum_YYYYMM.txt"]:::source
        XML["🏷 XML Hashtags <br/> hashtags/YYYY/WNN/hashtags_YYYYWNN.xml"]:::source
    end

    %% ─── BRONZE ─────────────────────────────────────────
    subgraph BRONZE ["🟤 Bronze Layer  (Delta Lake — APPEND)"]
        direction TB
        BI["inventario_delta"]:::bronze
        BT["trends_delta"]:::bronze
        BF["forum_delta"]:::bronze
        BH["hashtags_delta"]:::bronze
    end

    BP["bronze_pipeline.py <br/> • Deduplicação por source_file <br/> • Timestamps simulados <br/> • Schema merge"]:::control

    CSV --> BP
    JSON --> BP
    TXT --> BP
    XML --> BP
    BP --> BI & BT & BF & BH

    %% ─── SILVER ─────────────────────────────────────────
    subgraph SILVER ["⚪ Silver Layer  (Delta Lake — MERGE)"]
        direction TB
        SI["inventario_delta <br/> ✓ Tipagem, normalização marca/modelo"]:::silver
        ST["trends_delta <br/> ✓ Cast Int64, normalização via dicionário"]:::silver
        SF["forum_delta <br/> ✓ NLP RoBERTa, menções, dual-format"]:::silver
        SH["hashtags_delta <br/> ✓ Variação semanal, normalização hashtag"]:::silver
        Q["⛔ Quarentena <br/> Registos inválidos"]:::quart
    end

    SP["silver_pipeline.py <br/> • Validação e limpeza <br/> • Lookup no dicionário (PostgreSQL) <br/> • NLP: pysentimiento <br/> • data_quality_log"]:::control

    BI --> SP --> SI
    BT --> SP --> ST
    BF --> SP --> SF
    BH --> SP --> SH
    SP -. "Regras falhadas" .-> Q

    %% ─── POSTGRESQL ─────────────────────────────────────
    subgraph PG ["🗄 PostgreSQL — auto_escala_dw"]
        direction LR
        DIMS["Dimensões <br/> dim_stand / dim_modelo <br/> dim_veiculo / dim_tempo <br/> dim_fonte / dim_hashtag"]:::gold
        FACTS["Factos Transaccionais <br/> fct_venda <br/> fct_tendencia <br/> fct_hashtag_volume"]:::gold
        SNAP["Periodic Snapshot <br/> fct_inventario_mensal <br/> (último dia do mês)"]:::gold
        CTRL["Controlo <br/> pipeline_control <br/> data_quality_log <br/> audit_log_dimensions"]:::control
    end

    LP["load_to_postgres.py <br/> • UPSERT dimensões (SCD Tipo 1) <br/> • UPSERT factos <br/> • ELT snapshot inventário (SQL puro)"]:::control

    SI & ST & SF & SH --> LP
    LP --> DIMS --> FACTS
    LP --> SNAP
    LP --> CTRL

    %% ─── PROPHET ─────────────────────────────────────────
    PR["prophet_model.py <br/> • Lê fct_tendencia (Google Trends) <br/> • Treina 1 modelo por modelo_key <br/> • Escreve previsao_prox_mes de volta"]:::prophet
    FACTS --> PR --> FACTS