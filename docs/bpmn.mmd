flowchart TD
    %% ===================================================
    %% PIPELINE ETL MEDALLION — Auto Escala
    %% Bronze → Silver → PostgreSQL → ML Models
    %% ===================================================

    classDef source   fill:#475569,stroke:#94a3b8,color:#f1f5f9
    classDef bronze   fill:#92400e,stroke:#d97706,color:#fef3c7
    classDef silver   fill:#374151,stroke:#9ca3af,color:#f9fafb
    classDef quart    fill:#7f1d1d,stroke:#ef4444,color:#fee2e2
    classDef gold     fill:#713f12,stroke:#f59e0b,color:#fef9c3
    classDef ml       fill:#1e3a5f,stroke:#3b82f6,color:#dbeafe
    classDef control  fill:#1e1b4b,stroke:#6366f1,color:#e0e7ff

    %% ─── FONTES ─────────────────────────────────────────
    subgraph FONTES ["📂 Landing Zone  (data/sources/)"]
        direction TB
        CSV["🗂 CSV Inventário <br/> stands/YYYY_MM_stand.csv"]:::source
        JSON["📊 JSON Trends <br/> trends/google_trends.json"]:::source
        TXT["📝 TXT Fórum <br/> forum/YYYY_MM_forum.txt"]:::source
        XML["🏷 XML Hashtags <br/> hashtags/YYYY_WNN.xml"]:::source
        CLI["👤 CSV Clientes <br/> clientes/clientes.csv"]:::source
        DEMO["🌍 CSV Demografia <br/> demografia/demografia.csv"]:::source
    end

    %% ─── BRONZE ─────────────────────────────────────────
    subgraph BRONZE ["🟤 Bronze Layer  (Delta Lake — APPEND)"]
        direction TB
        BI["inventario_delta"]:::bronze
        BT["trends_delta"]:::bronze
        BF["forum_delta"]:::bronze
        BH["hashtags_delta"]:::bronze
    end

    BP["bronze_pipeline.py <br/> • Metadados de origem <br/> • Ingestão bruta <br/> • Schema evolution"]:::control

    FONTES --> BP --> BRONZE

    %% ─── SILVER ─────────────────────────────────────────
    subgraph SILVER ["⚪ Silver Layer  (Delta Lake — CLEAN)"]
        direction TB
        SI["inventario_delta <br/> ✓ Tipagem, normalização marca/modelo"]:::silver
        ST["trends_delta <br/> ✓ Cast Int64, normalização"]:::silver
        SF["forum_delta <br/> ✓ NLP Sentiment, menções"]:::silver
        SH["hashtags_delta <br/> ✓ Limpeza XML, volume"]:::silver
        Q["⛔ Quarentena <br/> Registos inválidos"]:::quart
    end

    SP["silver_pipeline.py <br/> • Validação e limpeza <br/> • Lookup no dicionário (PG) <br/> • NLP: pysentimiento <br/> • data_quality_log"]:::control

    BRONZE --> SP --> SILVER
    SP -. "Regras falhadas" .-> Q

    %% ─── POSTGRESQL ─────────────────────────────────────
    subgraph PG ["🗄 PostgreSQL — auto_escala_dw"]
        direction LR
        DIMS["Dimensões <br/> dim_veiculo, dim_modelo, <br/> dim_stand, dim_cliente, <br/> dim_demografia"]:::gold
        FACTS["Factos <br/> fct_venda, fact_trends, <br/> fact_forum_sentiment, <br/> fct_hashtag_volume"]:::gold
        VIEWS["Views de Mart <br/> vw_mart_compras <br/> vw_mart_stock <br/> vw_mart_direcao"]:::gold
    end

    LP["load_to_postgres.py <br/> • UPSERT dimensões (SCD Tipo 1) <br/> • UPSERT factos <br/> • Watermark control"]:::control

    SILVER --> LP --> PG

    %% ─── MODELS ─────────────────────────────────────────
    subgraph MODELS ["🔮 ML Forecasting"]
        M1["prev_tendencias.py <br/> (SARIMA)"]:::ml
        M3["prev_gain.py <br/> (XGBoost)"]:::ml
    end

    PG --> MODELS --> FACTS
